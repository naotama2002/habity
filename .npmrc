# pnpm configuration for Expo/React Native compatibility
# Uses hoisted node_modules structure instead of symlinks
node-linker=hoisted
# Hoist all packages to root for Gradle compatibility
shamefully-hoist=true
public-hoist-pattern[]=*

# サプライチェーン対策: 公開直後のバージョンを採用しない (7 日 = 10080 分)
#
# 侵害されたパッケージは公開から短時間で発見・削除されることが多いため、
# 一定期間おいてから取り込む。Dependabot 側にも cooldown を設定しているが、
# こちらは手元の pnpm add / expo install --fix にも効く。
#
# 緊急でどうしても必要な場合は minimum-release-age-exclude で個別に除外する。
minimum-release-age=10080
