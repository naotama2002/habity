{
  "name": "habity",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "NODE_ENV=test jest --ci --forceExit",
    "test:watch": "NODE_ENV=test jest --watchAll",
    "intl:extract": "lingui extract --clean",
    "intl:compile": "lingui compile",
    "intl:build": "pnpm intl:extract && pnpm intl:compile",
    "intl:check": "node scripts/check-translations.js",
    "check:web": "node scripts/check-web-bundle.js"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "date-fns": "^3.6.0",
    "expo": "~57.0.31",
    "expo-constants": "^57.0.22",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@jest/globals": "^30.5.2",
    "@lingui/babel-plugin-lingui-macro": "^6.10.0",
    "@lingui/cli": "^6.10.0",
    "@lingui/format-po": "^6.10.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "jsdom": "^20.0.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}
