# ===========================================
# React Native / Expo (for local dev with pnpm web)
# ===========================================
# `supabase start` 実行後に表示される Publishable key を設定
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase start で表示される Publishable key>
EXPO_PUBLIC_ENABLE_SIGNUP=true
