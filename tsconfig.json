{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // SDK 57 の expo/tsconfig.base 配下では node_modules/@types の
    // 自動取り込みが効かず、jest / node のグローバル型が解決できない。
    // 使用するアンビエント型を明示する。
    "types": ["jest", "node"],
    // baseUrl は TS 5.9 で deprecated。moduleResolution: "bundler" では
    // paths が tsconfig.json からの相対で解決されるため不要。
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["functions"]
}
